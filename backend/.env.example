# Copy to .env and fill in real values. Never commit .env.
PORT=5000
MONGO_URI=mongodb://localhost:27017/ecommerce
# Required in production — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Comma-separated list of allowed frontend origins for CORS
CLIENT_URL=https://shopflowdemo.vercel.app,http://localhost:3000
NODE_ENV=development
# Optional: enables POST /api/auth/seed-admin (send matching "x-seed-key" header). Leave unset to disable.
SEED_SECRET=
# Optional: credentials used by seed-admin (defaults: admin@store.com / admin123)
ADMIN_EMAIL=
ADMIN_PASSWORD=
